<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Project_2.MainPage"
             Title="Обробник XML: Конференції">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="Робота з XML-файлами конференцій" FontSize="20" HorizontalOptions="Center" FontAttributes="Bold" />

        
            <Button Text="Обрати XML-файл" Clicked="OnFileSelected" BackgroundColor="#2b5797" TextColor="White" />
            <Label x:Name="lblFilePath" Text="Файл не обрано" TextColor="Gray" FontSize="12" />

            <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="Тематика:" FontAttributes="Bold" />
                    <Picker x:Name="pickerField" Title="Оберіть тематику" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1">
                    <Label Text="Організатор:" FontAttributes="Bold" />
                    <Picker x:Name="pickerOrganizer" Title="Оберіть організатора" />
                </VerticalStackLayout>
            </Grid>

            <Label Text="Ключове слово (пошук у назві або місті):" FontAttributes="Bold" />
            <Entry x:Name="txtKeyword" Placeholder="Введіть слово для пошуку..." />

            <Label Text="Метод обробки (Патерн Strategy):" FontAttributes="Bold" />
            <HorizontalStackLayout Spacing="20">
                <RadioButton x:Name="rbSax" Content="SAX (XmlReader)" IsChecked="True" />
                <RadioButton x:Name="rbDom" Content="DOM (XmlDocument)" />
                <RadioButton x:Name="rbLinq" Content="LINQ to XML" />
            </HorizontalStackLayout>

            <Grid ColumnDefinitions="*, *, *" ColumnSpacing="10">
                <Button Grid.Column="0" Text="Пошук" Clicked="OnSearchClicked" BackgroundColor="#107c41" TextColor="White" />
                <Button Grid.Column="1" Text="В HTML" Clicked="OnTransformClicked" BackgroundColor="#d83b01" TextColor="White" />
                <Button Grid.Column="2" Text="Очистити (Clear)" Clicked="OnClearClicked" BackgroundColor="#5c2d91" TextColor="White" />
            </Grid>

            <Button Text="Вийти з програми" Clicked="OnExitRequested" BackgroundColor="#a80000" TextColor="White" Margin="0,5,0,0"/>

            <Label Text="Результати пошуку:" FontAttributes="Bold" Margin="0,10,0,0" />
            <Editor x:Name="txtResults" IsReadOnly="True" AutoSize="TextChanges" HeightRequest="220" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>